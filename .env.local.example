# Settings for docker-compose.local.yml. Copy this file to .env.local (it is not committed) and fill it in.

# Neon console → your project → Connect → turn "Connection pooling" OFF → copy the postgresql://… string
DATABASE_URL=

# Any long random text (signs the app's session cookie):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Same values as in Vercel / GitHub (each provider's dashboard); leave out any you don't have
SEC_USER_AGENT=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=
MASSIVE_API_KEY=
FMP_API_KEY=
TIINGO_API_KEY=
ALPHAVANTAGE_API_KEY=
SENTISENSE_API_KEY=

# Optional: lets "import Unusual Options CSV" start the scan on GitHub straight away (same token as in Vercel)
GITHUB_DISPATCH_TOKEN=

APP_ENV=production
SINGLE_USER_MODE=true
INSIDER_SOURCE=openinsider
