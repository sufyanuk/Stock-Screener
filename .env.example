# ---- Required ----------------------------------------------------------------
APP_ENV=production
POSTGRES_PASSWORD=change-me-strong-password
# 32+ random bytes:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Personal use: no login page (keep the deployment private). Set to false for multi-user logins.
SINGLE_USER_MODE=true
# SEC fair-access policy requires "<App name> <contact email>"
SEC_USER_AGENT="StockIntel you@example.com"
CORS_ORIGINS=http://localhost:3000

# ---- Market data (see docs/ARCHITECTURE.md for plans & costs) ----------------
# Options volume + IV history (ORATS Delayed Data API)
ORATS_API_KEY=
# Massive.com (formerly Polygon.io): prices, option chains, short interest, news
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
# Financial Modeling Prep: analyst grades / price targets, share float
FMP_API_KEY=
# Optional: Alpha Vantage free key — earnings-calendar fallback when FMP is not set
ALPHAVANTAGE_API_KEY=
# Stock prices (first choice) — Alpaca market data; free plan uses the IEX feed
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
# Analyst ratings (first choice) and stock-price fallback
FINNHUB_API_KEY=
# Historical prices (first choice)
TIINGO_API_KEY=
# SentiSense Rating + AI insights in the stock panel (free: 1,000 requests/month)
SENTISENSE_API_KEY=

# ---- Optional notifications --------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
